ARG NATIVE_IMAGE=liberty-emscripten:stage1-native
FROM ${NATIVE_IMAGE} AS stage1_c
COPY --from=liberty_source /src/ /opt/liberty/src/
COPY --from=liberty_source /sys/ /opt/liberty/sys/
COPY examples/ /examples/
COPY generate.sh /experiment/generate.sh
RUN bash /experiment/generate.sh

FROM emscripten/emsdk:7.0.0@sha256:3803e37bf748ddee14d31cf712fcab09ca367fca83bbefeb78ce4c1f284e6f3f AS verify
COPY --from=stage1_c /generated/ /generated/
COPY --from=stage1_c /opt/liberty/sys/ /opt/liberty/sys/
COPY build-wasm.sh /experiment/build-wasm.sh
RUN bash /experiment/build-wasm.sh
COPY web/ /out/
COPY --from=browser_output /validation/ /validation/
COPY stage2/build-validation.sh /experiment/build-validation.sh
RUN bash /experiment/build-validation.sh
COPY stage2/validation-web/ /out/validation/

FROM scratch AS artifacts
COPY --from=verify /out/ /
