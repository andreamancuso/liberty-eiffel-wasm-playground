ARG TOOLCHAIN_IMAGE=liberty-emscripten:stage3-toolchain
FROM ${TOOLCHAIN_IMAGE} AS site
COPY --from=stage2_output /compiler.mjs /compiler.wasm /compiler.data /runtime.mjs /client.mjs /worker.mjs /provenance.json /out/stage2/
COPY --from=stage2_output /licenses/ /out/licenses/liberty/
COPY stage2/web/ /out/stage2/
COPY stage3/client.mjs stage3/worker.mjs stage3/wasi.mjs /out/
COPY stage3/web/ /out/
FROM scratch AS artifacts
COPY --from=site /out/ /
